Import('env', 'PackerLayer')

PackerLayer(
    uses=['defaults/common'],
    locals={
        'headless': True,
        'cpus': 2,
        'memory': 4000,
        'usb': False,
        'usbehci': False,
        'vrde': False,
        'clipboard_mode': 'disabled',
    },
    builder={
        'vm_name': '${local.name}',
        'headless': '${local.headless}',
        'output_directory': '${local.build_directory}/${local.target}/virtualbox',
        'output_filename': 'output',
        'vboxmanage': [
            ['modifyvm', '{{.Name}}', '--usbehci', '${local.usbehci ? "on" : "off"}'],
            ['modifyvm', '{{.Name}}', '--clipboard-mode', '${local.clipboard_mode}'],
            ['modifyvm', '{{.Name}}', '--vrde', '${local.vrde ? "on" : "off"}'],
        ],
        'guest_additions_url': '${local.guest_additions_url}',
    },
)
