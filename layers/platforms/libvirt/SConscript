Import('env', 'PackerLayer')

PackerLayer(
    type='qemu',
    uses=['defaults/common'],
    locals={
        'headless': True,
        'cpus': 2,
        'memory': 4000,
    },
    builder={
        'headless': '${local.headless}',
        'output_directory': '${local.build_directory}/${local.target}/libvirt',
        'format': 'qcow2',
        'vm_name': '${var.target}',
        'accelerator': 'kvm',
    },
)
